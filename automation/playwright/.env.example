# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real credentials.

# Target under test. Defaults to production if unset.
VAULTCV_BASE_URL=https://app.vaultcv.com

# Disposable test account used by tests/auth.setup.ts to establish a session.
VAULTCV_TEST_EMAIL=
VAULTCV_TEST_PASSWORD=
